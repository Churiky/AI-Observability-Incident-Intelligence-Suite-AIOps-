# Environment Variables for AI Observability Platform

# FastAPI Settings
FAPI_HOST=0.0.0.0
FAPI_PORT=8000
FAPI_RELOAD=True
FAPI_DEBUG=True

# Database Settings
POSTGRES_SERVER=postgres
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability_pass
POSTGRES_DB=observability_db
POSTGRES_PORT=5432

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Ollama Settings (Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# Embedding Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS Settings
FAISS_INDEX_PATH=./ml/artifacts/faiss_index

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO